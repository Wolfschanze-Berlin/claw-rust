# LLM Provider API Keys (configure at least one)
# OPENROUTER_API_KEY=sk-or-v1-xxx
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-google-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_API_KEY=your-gemini-api-key
GITHUB_TOKEN=ghp_your-github-token
GH_TOKEN=ghp_your-github-token

# Gateway authentication token
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-hex

# Channel tokens — bot tokens moved to per-agent .env files
# See openclawd-agents/<agent>/.env
# DISCORD_BOT_TOKEN=xxx
# SLACK_BOT_TOKEN=xoxb-xxx


# For external Postgres (e.g. Neon):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432
DO_NOT_REQUIRE_SSL=1
RUST_LOG=info,common::errors=debug
RUST_BACKTRACE=1
# ─── S3 Storage (optional; default is local filesystem) ───────────────
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=ap-southeast-1

SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD="your-smtp-app-password"
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM="your-from-address@example.com"
